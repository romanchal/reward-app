{
  "name": "reward-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "web",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w web\" \"npm run dev -w admin\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:admin": "vite --host 0.0.0.0",
    "build": "npm run build -w backend -w web -w admin",
    "build:web": "tsc && vite build",
    "build:admin": "tsc && vite build",
    "build:backend": "tsc",
    "test": "npm run test:backend -w backend",
    "test:backend": "tsx --test test/*.test.ts",
    "typecheck": "npm run typecheck -w backend -w web -w admin",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit",
    "typecheck:admin": "tsc --noEmit",
    "seed": "tsx backend/scripts/seed.ts",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:reset": "tsx backend/scripts/reset.ts",
    "lint:fix": "eslint backend/src web/src admin/src --ext ts --fix",
    "docker:up": "docker compose up --build",
    "clean": "rimraf node_modules backend/node_modules web/node_modules admin/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.5.0",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
