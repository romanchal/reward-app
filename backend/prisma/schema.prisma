generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core enums
enum UserRole {
  USER
  ADMIN
}

enum TaskStatus {
  LIVE
  DEMO
}

enum TransactionType {
  TASK_REWARD
  REFERRAL_REWARD
}

enum TransactionStatus {
  POSTED
}

// Core Models
model User {
  id               String         @id @default(cuid())
  email            String         @unique
  emailNormalized  String         @unique
  name             String
  passwordHash     String         @unique
  role             UserRole       @default(USER)
  isVerified       Boolean        @default(false)
  banned           Boolean        @default(false)
  balance          Int            @default(0)
  referralCode     String         @unique @default(cuid())
  deviceId         String?
  streakId         String?
  fraudEvents         FraudEvent[]
  referredBy          Referral[]     @relation("ReferralUser")
  referred            Referral[]     @relation("UserReferrals")
  streak              Streak?
  refreshTokens       RefreshToken[]
  userTasks      UserTask[]
  wallet          Wallet?
  walletTransactions WalletTransaction[]
  withdrawals      Withdrawal[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([emailNormalized])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String
  link         String?
  imageUrl     String?
  reward       Int
  status       TaskStatus   @default(LIVE)
  isDemo       Boolean      @default(false)
  userTasks    UserTask[]
  transactions WalletTransaction[] @relation("TaskTransactions")
}

model UserTask {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedAt DateTime   @default(now())
  @@unique([userId, taskId])
}

model Wallet {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Int           @default(0)
  currency    String        @default("INR")
  transactions WalletTransaction[] @relation("WalletTransactions")
  createdAt   DateTime     @default(now())
}

model WalletTransaction {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId     String
  wallet       Wallet         @relation("WalletTransactions", fields: [walletId], references: [id])
  taskId       String?
  task         Task?          @relation("TaskTransactions", fields: [taskId], references: [id])
  type         TransactionType
  amount       Int
  currency     String
  status       TransactionStatus @default(POSTED)
  balanceAfter Int
  referenceId  String?
  createdAt    DateTime       @default(now())

  @@index([taskId])
}

model Withdrawal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  currency   String   @default("INR")
  method     String
  recipient  String
  status     String   @default("PENDING")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
}

model Referral {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation("UserReferrals", fields: [userId], references: [id], onDelete: Cascade)
  referredByUserId String?
  referredBy      User?          @relation("ReferralUser", fields: [referredByUserId], references: [id], onDelete: SetNull)
  code            String         @unique
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  @@index([referredByUserId])
  @@index([userId])
}

// Minimal supporting models referenced by the application code
model FraudEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  severity  String
  score     Int
  status    String
  details   Json?
  createdAt DateTime @default(now())
}

model Streak {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count     Int      @default(0)
  lastAt    DateTime?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revokedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  details      Json?
  createdAt    DateTime @default(now())
}

