{
  "name": "reward-app-backend",
  "version": "1.0.0",
  "description": "Production backend for Reward App",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test --timeout=10000 test/*.test.ts",
    "test:coverage": "tsx --test --coverage test/*.test.ts",
    "test:watch": "tsx --watch --test test/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier src --write",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "signal-exit": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^6.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.19.0",
    "pg-mem": "^3.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "author": "Reward App Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reward-app/backend.git"
  }
}
