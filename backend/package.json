{
  "name": "reward-app-backend",
  "version": "1.0.0",
  "description": "Production backend for Reward App",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --coverage test/*.test.ts",
    "test:watch": "tsx --watch --test test/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier src --write",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "signal-exit": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "author": "Reward App Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reward-app/backend.git"
  }
}
