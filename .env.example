NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://reward_app:reward_app@localhost:5432/reward_app
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-separate-long-random-refresh-secret
# 32-byte key for field encryption (AES-256-GCM). Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ENCRYPTION_KEY=replace-with-64-hex-chars-representing-32-random-bytes
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
PAYMENT_MODE=demo
OFFER_MODE=demo
EMAIL_MODE=console
PUSH_MODE=optional
REDIS_URL=
