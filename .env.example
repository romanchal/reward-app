NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://reward_app:reward_app@localhost:5432/reward_app
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-separate-long-random-refresh-secret
# 32-byte key for field encryption (AES-256-GCM). Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ENCRYPTION_KEY=replace-with-64-hex-chars-representing-32-random-bytes
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
PAYMENT_MODE=demo
OFFER_MODE=demo
EMAIL_MODE=console
PUSH_MODE=optional
REDIS_URL=

# Razorpay payouts (leave empty for demo mode — admin APPROVE will NOT auto-call provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=
RAZORPAY_WEBHOOK_SECRET=

# Withdrawal limits (minor-currency units; defaults shown)
WITHDRAWAL_MIN=100
WITHDRAWAL_MAX=100000
WITHDRAWAL_DAILY_LIMIT=200000

# Sentry (leave empty to disable)
SENTRY_DSN=
VITE_SENTRY_DSN=
